{
  "name": "tache-enfant",
  "version": "1.0.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev-server.mjs",
    "build:config": "node build-firebase-config.mjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "start": "node server.js",
    "dev:docker": "docker-compose -f docker-compose.dev.yml up",
    "dev:docker:build": "docker-compose -f docker-compose.dev.yml build",
    "dev:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://dailykids:dailykids@localhost:5432/dailykids} node seed-demo-only.mjs",
    "migrate": "docker-compose -f docker-compose.dev.yml exec -T db psql -v ON_ERROR_STOP=1 -U dailykids -d dailykids < migration.sql"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "supertest": "^6.3.3",
    "vitest": "^1.0.4"
  }
}
